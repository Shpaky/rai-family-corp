---
/*
  /manufacturers/: how we work with Russian manufacturers. Page header on paper,
  then the sections of MANUFACTURERS_SECTIONS that have data, alternating white /
  paper by position, and the dark "Where to start" block as the only dark
  surface. Copy lives in src/data/manufacturers.ts, the services in
  src/data/services.ts; empty data renders nothing.
*/
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import Catalog from '@/components/manufacturers/Catalog.astro';
import Faq from '@/components/manufacturers/Faq.astro';
import Models from '@/components/manufacturers/Models.astro';
import NotDoing from '@/components/manufacturers/NotDoing.astro';
import Requirements from '@/components/manufacturers/Requirements.astro';
import Route from '@/components/manufacturers/Route.astro';
import Start from '@/components/manufacturers/Start.astro';
import type { SectionTone } from '@/components/sections/types';
import Base from '@/layouts/Base.astro';
import {
  MANUFACTURERS_SECTIONS,
  answeredFaq,
  manufacturersPage,
  type ManufacturersSectionKey,
} from '@/data/manufacturers';
import { services } from '@/data/services';
import type { Locale } from '@/i18n/config';
import { href, localePaths, t } from '@/i18n/utils';

export function getStaticPaths() {
  return localePaths();
}

const { locale } = Astro.props as { locale: Locale };
const copy = t(locale);
const data = manufacturersPage[locale];
const home = href(locale);
const path = 'manufacturers/';
const url = getAbsoluteLocaleUrl(locale, path);

const components = {
  route: Route,
  catalog: Catalog,
  requirements: Requirements,
  models: Models,
  notDoing: NotDoing,
  faq: Faq,
} as const;
const hasData: Record<ManufacturersSectionKey, boolean> = {
  route: data.route.steps.length > 0,
  catalog: services[locale].groups.length > 0,
  requirements: data.requirements.common.length > 0,
  models: data.models.items.length > 0,
  notDoing: data.notDoing.items.length > 0,
  faq: answeredFaq(locale).length > 0,
};
// The lead promises "what we do not do" only when that section is rendered.
const lead = hasData.notDoing ? data.hero.leadWithNotDoing : data.hero.lead;
// Rendered sections only, so the white / paper alternation has no gaps.
const sections = MANUFACTURERS_SECTIONS.filter((key) => hasData[key]).map((key, i) => ({
  key,
  Component: components[key],
  tone: (i % 2 === 0 ? 'white' : 'surface') as SectionTone,
}));

const organization = {
  '@type': 'Organization',
  name: 'Rai Family Corp',
  url: getAbsoluteLocaleUrl('en', ''),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': url,
      url,
      name: data.meta.title,
      description: data.meta.description,
      inLanguage: locale,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Rai Family Corp',
        url: getAbsoluteLocaleUrl(locale, ''),
      },
      about: organization,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Rai Family Corp',
          item: getAbsoluteLocaleUrl(locale, ''),
        },
        { '@type': 'ListItem', position: 2, name: copy.nav.manufacturers, item: url },
      ],
    },
    {
      '@type': 'FAQPage',
      inLanguage: locale,
      mainEntity: answeredFaq(locale).map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<Base
  locale={locale}
  title={data.meta.title}
  description={data.meta.description}
  path={path}
  jsonLd={jsonLd}
>
  <header class="bg-surface">
    <div class="container-page py-12 md:py-16">
      <nav aria-label="Breadcrumb" class="text-sm font-semibold text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={home} class="hover:text-primary">Rai Family Corp</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{copy.nav.manufacturers}</li>
        </ol>
      </nav>
      <p class="eyebrow mt-6 text-eyebrow">{data.hero.eyebrow}</p>
      <h1 class="mt-3 text-h2 font-bold text-balance text-ink sm:text-h1 md:text-display">
        {data.hero.title}
      </h1>
      <p class="mt-5 max-w-3xl text-lead text-pretty text-ink-soft">{lead}</p>
    </div>
  </header>

  {sections.map(({ Component, tone }) => <Component locale={locale} tone={tone} />)}

  <Start locale={locale} />

  {
    /*
      The only client code of the page. Folds data-collapse="mobile" blocks below md
      and opens them from md; without JS they stay open. A link to a folded block
      (#services-<slug>) opens it. Comments stay out of the script: it ships as is.
    */
  }
  <script is:inline>
    (() => {
      const mq = matchMedia('(max-width: 767px)');
      const sync = () => {
        for (const d of document.querySelectorAll('details[data-collapse="mobile"]'))
          d.open = !mq.matches;
      };
      const target = () => {
        const d = document.getElementById(location.hash.slice(1));
        if (d instanceof HTMLDetailsElement) d.open = true;
      };
      sync();
      target();
      mq.addEventListener('change', sync);
      addEventListener('hashchange', target);
    })();
  </script>
</Base>

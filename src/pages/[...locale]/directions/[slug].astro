---
import { getCollection } from 'astro:content';
import Button from '@/components/Button.astro';
import Contacts from '@/components/sections/Contacts.astro';
import StatusLockup from '@/components/StatusLockup.astro';
import DirectionCard from '@/components/DirectionCard.astro';
import Base from '@/layouts/Base.astro';
import { LOCALES, DEFAULT_LOCALE, type Locale } from '@/i18n/config';
import { href, siteHref, t } from '@/i18n/utils';

export async function getStaticPaths() {
  const entries = (await getCollection('directions', (e) => e.data.published)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return LOCALES.flatMap((locale) =>
    entries.map((entry) => ({
      params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug: entry.id },
      props: { locale, entry, others: entries.filter((e) => e.id !== entry.id) },
    })),
  );
}

type Entry = Awaited<ReturnType<typeof getCollection<'directions'>>>[number];
const { locale, entry, others } = Astro.props as { locale: Locale; entry: Entry; others: Entry[] };
const copy = t(locale);
const d = entry.data;
const text = d.i18n[locale];
const path = `directions/${entry.id}/`;
const home = href(locale);
const title = `${text.title} — Rai Family Corp`;
---

<Base locale={locale} title={title} description={text.summary} path={path} ogType="article">
  <article>
    <header class="bg-surface">
      <div class="container-page py-12 md:py-16">
        <nav aria-label="Breadcrumb" class="text-sm font-semibold text-muted">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href={home} class="hover:text-primary">Rai Family Corp</a></li>
            <li aria-hidden="true">/</li>
            <li>
              <a href={`${home}#directions`} class="hover:text-primary">{copy.directions.all}</a>
            </li>
          </ol>
        </nav>
        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class="eyebrow text-primary">{copy.directions.category[d.category]}</span>
          <span class="rounded-pill bg-white px-2.5 py-1 text-xs font-bold text-ink-soft">
            {copy.directions.status[d.status]}
          </span>
        </div>
        <p class="mt-4 text-sm font-semibold text-muted">{d.brand}</p>
        <h1 class="mt-1 text-h1 font-extrabold text-balance text-ink md:text-display">
          {text.title}
        </h1>
        <p class="mt-5 max-w-2xl text-lead text-pretty text-ink-soft">{text.summary}</p>
      </div>
    </header>

    <div class="container-page grid gap-12 py-section-sm lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <div class="space-y-5 text-lg leading-relaxed text-ink-soft">
          {text.body.map((p) => <p>{p}</p>)}
        </div>
        {
          text.products.length > 0 && (
            <ul class="mt-10 grid gap-4 sm:grid-cols-2">
              {text.products.map((product) => (
                <li class="rounded-card border border-line bg-surface p-6">
                  <h2 class="text-h3 font-extrabold text-ink">{product.name}</h2>
                  <p class="mt-2 text-base leading-relaxed text-ink-soft">{product.text}</p>
                </li>
              ))}
            </ul>
          )
        }
        {
          text.facts.length > 0 && (
            <section
              class="mt-10 rounded-card border border-line bg-white p-7 shadow-card"
              aria-labelledby="facts-title"
            >
              <h2 id="facts-title" class="text-h3 font-extrabold text-ink">
                {copy.directions.keyData}
              </h2>
              <ul class="mt-4 divide-y divide-line border-t border-line">
                {text.facts.map((fact) => (
                  <li class="flex items-start gap-3 py-3 text-base leading-snug text-ink-soft">
                    <svg
                      class="mt-1 size-4 shrink-0 text-primary"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    {fact}
                  </li>
                ))}
              </ul>
              {text.logistics && (
                <p class="mt-4 text-base font-semibold text-ink">{text.logistics}</p>
              )}
              {d.documents.length > 0 && (
                <div class="mt-6 flex flex-wrap items-center gap-3">
                  <span class="eyebrow text-muted">{copy.directions.documents}</span>
                  {d.documents.map((doc) => (
                    <Button href={doc.url} variant="ghost" external>
                      {doc.label}
                    </Button>
                  ))}
                </div>
              )}
            </section>
          )
        }
      </div>
      <aside class="lg:col-span-5">
        <div class="rounded-card border border-line bg-white p-7 shadow-card">
          {
            d.site ? (
              <Button href={siteHref(d.site, locale)} size="lg" external class="w-full">
                {copy.directions.visitSite}
              </Button>
            ) : (
              <p class="rounded-pill bg-surface px-5 py-3.5 text-center text-base font-bold text-muted">
                {copy.directions.siteSoon}
              </p>
            )
          }
          <p class="mt-6 eyebrow text-muted">{copy.directions.audiencesLabel}</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {
              (text.forWhom.length > 0
                ? text.forWhom
                : d.audiences.map((a) => copy.audiences.items[a].title)
              ).map((label) => (
                <li class="rounded-pill bg-primary-soft px-3 py-1 text-sm font-semibold text-primary">
                  {label}
                </li>
              ))
            }
          </ul>
          <StatusLockup locale={locale} variant="compact" class="mt-6 border-t border-line pt-6" />
          <p class="mt-4 text-base text-ink-soft">{copy.directions.contactsIntro}</p>
          <Button href="#contacts" variant="secondary" class="mt-4 w-full">
            {copy.directions.backToContacts}
          </Button>
        </div>
      </aside>
    </div>

    {
      others.length > 0 && (
        <section class="bg-surface py-section-sm" aria-labelledby="others-title">
          <div class="container-page">
            <h2 id="others-title" class="text-h2 font-extrabold text-ink">
              {copy.directions.otherDirections}
            </h2>
            <ul class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
              {others.map((e) => (
                <li class="relative">
                  <DirectionCard entry={e} locale={locale} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </article>
  <Contacts locale={locale} compact />
</Base>

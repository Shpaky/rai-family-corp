---
/*
  One route for two kinds of pages: /directions/<category>/ (catalog filtered by
  category) and /directions/<slug>/ (direction page). Slugs must not collide.
*/
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import DirectionPage from '@/components/DirectionPage.astro';
import DirectionsCatalog from '@/components/DirectionsCatalog.astro';
import Contacts from '@/components/sections/Contacts.astro';
import Base from '@/layouts/Base.astro';
import { LOCALES, DEFAULT_LOCALE, type Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';
import {
  getCategoriesWithDirections,
  getDirections,
  type Category,
  type Direction,
} from '@/lib/directions';

export async function getStaticPaths() {
  const all = await getDirections();
  const groups = await getCategoriesWithDirections(all);
  const categoryIds = new Set(groups.map((g) => g.category.id));
  for (const d of all) {
    if (d.id === 'index' || categoryIds.has(d.id)) {
      throw new Error(`Direction slug "${d.id}" collides with a category slug or "index".`);
    }
  }
  return LOCALES.flatMap((locale) => {
    const param = locale === DEFAULT_LOCALE ? undefined : locale;
    return [
      ...groups.map(({ category }) => ({
        params: { locale: param, slug: category.id },
        props: { kind: 'category' as const, locale, category, groups },
      })),
      ...all.map((entry) => ({
        params: { locale: param, slug: entry.id },
        props: { kind: 'direction' as const, locale, entry, groups },
      })),
    ];
  });
}

type Groups = { category: Category; directions: Direction[] }[];
type Props =
  | { kind: 'category'; locale: Locale; category: Category; groups: Groups }
  | { kind: 'direction'; locale: Locale; entry: Direction; groups: Groups };
const props = Astro.props as Props;
const { locale, groups } = props;
const copy = t(locale);
const categories = groups.map((g) => g.category);
const all = groups.flatMap((g) => g.directions);
---

{
  props.kind === 'category' ? (
    <Base
      locale={locale}
      title={`${props.category.data.i18n[locale].name} — ${copy.directions.catalog.title} — Rai Family Corp`}
      description={props.category.data.i18n[locale].description}
      path={`directions/${props.category.id}/`}
      jsonLd={{
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: props.category.data.i18n[locale].name,
        itemListElement: groups
          .find((g) => g.category.id === props.category.id)!
          .directions.map((d, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: d.data.i18n[locale].title,
            url: getAbsoluteLocaleUrl(locale, `directions/${d.id}/`),
          })),
      }}
    >
      <DirectionsCatalog locale={locale} groups={groups} current={props.category} />
    </Base>
  ) : (
    <Base
      locale={locale}
      title={`${props.entry.data.i18n[locale].title} — Rai Family Corp`}
      description={props.entry.data.i18n[locale].summary}
      path={`directions/${props.entry.id}/`}
      ogType="article"
      jsonLd={{
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: props.entry.data.i18n[locale].title,
        description: props.entry.data.i18n[locale].summary,
        brand: { '@type': 'Brand', name: props.entry.data.brand },
        ...(props.entry.data.manufacturer
          ? { manufacturer: { '@type': 'Organization', name: props.entry.data.manufacturer.name } }
          : {}),
        category: categories.find((c) => c.id === props.entry.data.category.id)?.data.i18n[locale]
          .name,
        url: getAbsoluteLocaleUrl(locale, `directions/${props.entry.id}/`),
        ...(props.entry.data.image
          ? { image: new URL(props.entry.data.image.src, Astro.site).toString() }
          : {}),
      }}
    >
      <DirectionPage locale={locale} entry={props.entry} categories={categories} all={all} />
      <Contacts locale={locale} compact />
    </Base>
  )
}

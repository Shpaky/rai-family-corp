---
import Base from '@/layouts/Base.astro';
import About from '@/components/sections/About.astro';
import Audiences from '@/components/sections/Audiences.astro';
import Contacts from '@/components/sections/Contacts.astro';
import Directions from '@/components/sections/Directions.astro';
import Hero from '@/components/sections/Hero.astro';
import Pavilion from '@/components/sections/Pavilion.astro';
import Services from '@/components/sections/Services.astro';
import type { SectionTone } from '@/components/sections/types';
import { HOME_SECTIONS } from '@/data/site';
import type { Locale } from '@/i18n/config';
import { localePaths, t } from '@/i18n/utils';

export function getStaticPaths() {
  return localePaths();
}

const { locale } = Astro.props as { locale: Locale };
const copy = t(locale);
// Order and background of the sections come from src/data/site.ts only.
const sections = {
  audiences: Audiences,
  directions: Directions,
  services: Services,
  pavilion: Pavilion,
  about: About,
  contacts: Contacts,
};
---

<Base locale={locale} title={copy.meta.title} description={copy.meta.description}>
  <Hero locale={locale} />
  {
    HOME_SECTIONS[locale].map((key, i) => {
      const Section = sections[key];
      // Hero is always white, so index 0 is paper and the row alternates from there.
      // Do not change the parity: inserting a section anywhere flips the ones below it.
      const tone: SectionTone = i % 2 === 0 ? 'surface' : 'white';
      return <Section locale={locale} tone={tone} />;
    })
  }
</Base>

---
import Base from '@/layouts/Base.astro';
import About from '@/components/sections/About.astro';
import Audiences from '@/components/sections/Audiences.astro';
import Hero from '@/components/sections/Hero.astro';
import Services from '@/components/sections/Services.astro';
import type { Locale } from '@/i18n/config';
import { localePaths, t } from '@/i18n/utils';

export function getStaticPaths() {
  return localePaths();
}

const { locale } = Astro.props as { locale: Locale };
const copy = t(locale);
---

<Base locale={locale} title={copy.meta.title} description={copy.meta.description}>
  <Hero locale={locale} />
  <Audiences locale={locale} />
  <About locale={locale} />
  <Services locale={locale} />
</Base>

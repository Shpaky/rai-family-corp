---
/*
  Direction card: one component for the home carousel, the catalog grid and
  "Similar directions". A projection of the direction entry; the category entry
  is passed in so the card never queries the collection itself.
*/
import { Picture } from 'astro:assets';
import type { Locale } from '@/i18n/config';
import { href, t } from '@/i18n/utils';
import type { Category, Direction } from '@/lib/directions';

interface Props {
  entry: Direction;
  category: Category;
  locale: Locale;
  headingLevel?: 'h3' | 'h2';
  /** Load the cover eagerly (first cards of the carousel). */
  eager?: boolean;
}
const { entry, category, locale, headingLevel: Heading = 'h3', eager = false } = Astro.props;
const copy = t(locale);
const d = entry.data;
const text = d.i18n[locale];
const categoryName = category.data.i18n[locale].name;
const url = href(locale, `directions/${entry.id}/`);
const tone = { warm: 'bg-warm', surface: 'bg-surface', 'surface-strong': 'bg-surface-strong' }[
  category.data.tone
];
const statusTone = d.status === 'active' ? 'bg-warm text-dark' : 'bg-surface text-muted';
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-card border border-line bg-white shadow-card transition-shadow hover:shadow-card-hover"
>
  {
    d.image ? (
      <Picture
        src={d.image}
        alt={text.title}
        widths={[360, 540, 720]}
        sizes="(min-width: 768px) 360px, 90vw"
        formats={['avif', 'webp']}
        loading={eager ? 'eager' : 'lazy'}
        class="aspect-4/3 w-full object-cover"
      />
    ) : (
      <div class="flex aspect-4/3 w-full items-center justify-center bg-surface-strong">
        <span class="eyebrow text-ink-soft">{categoryName}</span>
      </div>
    )
  }
  <div class:list={['flex items-center justify-between gap-3 px-6 py-3', tone]}>
    <span class="eyebrow text-ink">{categoryName}</span>
    <span class:list={['rounded-pill px-2.5 py-1 text-xs font-bold', statusTone]}>
      {copy.directions.status[d.status]}
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-sm font-semibold text-muted">{d.brand}</p>
    <Heading class="mt-1 text-h3 font-bold text-ink">
      <a href={url} class="after:absolute after:inset-0 focus-visible:outline-none">{text.title}</a>
    </Heading>
    <p class="mt-3 flex-1 text-base leading-relaxed text-ink-soft">{text.summary}</p>
    {
      text.keyFigures.length > 0 && (
        <p class="mt-4 flex flex-wrap items-center gap-x-2 text-sm font-bold text-ink">
          {text.keyFigures.map((figure, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <span>{figure}</span>
            </>
          ))}
        </p>
      )
    }
    {
      text.products.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {text.products.map((product) => (
            <li class="rounded-pill bg-surface px-3 py-1 text-xs font-bold text-ink-soft">
              {product.name}
            </li>
          ))}
        </ul>
      )
    }
    {text.logistics && <p class="mt-3 text-sm text-muted">{text.logistics}</p>}
    <span
      class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-primary"
      aria-hidden="true"
    >
      {copy.directions.more}
      <svg
        class="size-4 motion-safe:transition-transform motion-safe:group-hover:translate-x-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>
</article>

---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/i18n/config';
import { href, t } from '@/i18n/utils';

interface Props {
  entry: CollectionEntry<'directions'>;
  locale: Locale;
  headingLevel?: 'h3' | 'h2';
}
const { entry, locale, headingLevel: Heading = 'h3' } = Astro.props;
const copy = t(locale);
const d = entry.data;
const text = d.i18n[locale];
const url = href(locale, `directions/${entry.id}/`);
const tone = {
  'food-and-drinks': 'bg-brand-sky-light text-ink',
  construction: 'bg-warm-strong text-ink',
  industrial: 'bg-surface-strong text-ink',
  consumer: 'bg-warm text-ink',
  other: 'bg-surface text-ink',
}[d.category];
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-card border border-line bg-white shadow-card transition-shadow hover:shadow-card-hover"
>
  <div class:list={['flex items-center justify-between gap-3 px-6 py-4', tone]}>
    <span class="eyebrow">{copy.directions.category[d.category]}</span>
    <span class="rounded-pill bg-white/70 px-2.5 py-1 text-xs font-bold text-ink-soft">
      {copy.directions.status[d.status]}
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-sm font-semibold text-muted">{d.brand}</p>
    <Heading class="mt-1 text-h3 font-extrabold text-ink">
      <a href={url} class="after:absolute after:inset-0 focus-visible:outline-none">{text.title}</a>
    </Heading>
    <p class="mt-3 flex-1 text-base leading-relaxed text-ink-soft">{text.summary}</p>
    {
      text.products.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {text.products.map((product) => (
            <li class="rounded-pill bg-surface px-3 py-1 text-xs font-bold text-ink-soft">
              {product.name}
            </li>
          ))}
        </ul>
      )
    }
    <span
      class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-primary"
      aria-hidden="true"
    >
      {copy.directions.more}
      <svg
        class="size-4 motion-safe:transition-transform motion-safe:group-hover:translate-x-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </span>
  </div>
</article>

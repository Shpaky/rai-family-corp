---
/*
  Native <details> block. Without JavaScript it keeps the `open` it was rendered
  with, so nothing is lost. With `collapseOnMobile` it carries
  data-collapse="mobile": the inline script of the page closes it below `md`
  and opens it from `md` (on load and when the media query changes).

  Variants: `more` is a "More about this step" fold inside a card; with
  `collapseOnMobile` its summary is hidden from `md`, where the block is always
  open. `card` is a bordered card with the summary as its title (and an optional
  number before it), `row` a question in a divided list; their summaries stay
  visible at every width.
*/
interface Props {
  summary: string;
  open?: boolean;
  collapseOnMobile?: boolean;
  variant?: 'more' | 'card' | 'row';
  /** Number before the summary text, e.g. "01" (card variant). */
  number?: string;
  /** Anchor of the block; links to it open the block (inline script of the page). */
  id?: string;
  class?: string;
}
const {
  summary,
  open = false,
  collapseOnMobile = false,
  variant = 'more',
  number,
  id,
  class: className = '',
} = Astro.props;

const reset = 'cursor-pointer list-none marker:hidden [&::-webkit-details-marker]:hidden';
const summaryClass = {
  more: [
    'inline-flex items-center gap-1.5 py-2 text-sm font-bold text-primary hover:text-primary-hover',
    collapseOnMobile && 'md:hidden',
  ],
  card: 'flex items-center gap-4 px-5 py-3 text-base font-bold text-ink md:py-4',
  row: 'flex items-start gap-4 text-base font-bold text-ink',
}[variant];
const bodyClass = { more: '', card: 'px-5 pb-5', row: 'mt-2' }[variant];
---

<details
  id={id}
  class:list={[
    'group/collapsible',
    variant === 'card' && 'rounded-card border border-line bg-white',
    variant === 'row' && 'py-3 md:py-4',
    className,
  ]}
  open={open}
  data-collapse={collapseOnMobile ? 'mobile' : undefined}
>
  <summary class:list={[reset, summaryClass]}>
    {number && <span class="text-h3 font-bold text-gold-deep tabular-nums">{number}</span>}
    <span class={variant === 'more' ? undefined : 'flex-1'}>{summary}</span>
    <svg
      class:list={[
        'size-4 shrink-0 text-primary group-open/collapsible:rotate-180 motion-safe:transition-transform',
        variant === 'row' && 'mt-1',
      ]}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </summary>
  <div class={bodyClass || undefined}>
    <slot />
  </div>
</details>

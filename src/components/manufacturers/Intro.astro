---
/*
  Page header of /manufacturers/ on paper: breadcrumbs, eyebrow, H1 and the lead
  from src/data/manufacturers.ts, then the four market figures and two
  sentences under them, each its own paragraph, from src/data/market.ts, inside
  the same section. The figures are plain text with a source and year under
  each; no icons, charts or counters. No copy in the component.
*/
import { manufacturersPage } from '@/data/manufacturers';
import { market } from '@/data/market';
import type { Locale } from '@/i18n/config';
import { href, t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const { hero } = manufacturersPage[locale];
const { tiles, after } = market[locale];
const home = href(locale);
---

<header class="bg-surface">
  <div class="container-page py-12 md:py-16">
    <nav aria-label="Breadcrumb" class="text-sm font-semibold text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href={home} class="hover:text-primary">Rai Family Corp</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{copy.nav.manufacturers}</li>
      </ol>
    </nav>
    <p class="eyebrow mt-6 text-eyebrow">{hero.eyebrow}</p>
    <h1 class="mt-3 text-h2 font-bold text-balance text-ink sm:text-h1 md:text-display">
      {hero.title}
    </h1>
    <p class="mt-5 max-w-3xl text-lead text-pretty text-ink-soft">{hero.lead}</p>

    <ul class="mt-10 grid gap-x-6 gap-y-7 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-8">
      {
        tiles.map((tile) => (
          <li class="border-t border-line pt-5">
            <p class="font-display text-h1 font-bold text-gold-deep lining-nums tabular-nums">
              {tile.value}
            </p>
            <p class="mt-2.5 text-base leading-snug text-ink-soft">{tile.label}</p>
            <p class="mt-2 text-xs text-muted">
              {tile.source}, {tile.asOf}
            </p>
          </li>
        ))
      }
    </ul>
    <div class="mt-8 max-w-3xl">
      {
        after.map((line, i) => (
          <p class:list={['text-base leading-relaxed text-ink-soft', i > 0 && 'mt-1.5']}>
            {line.text}
          </p>
        ))
      }
    </div>
  </div>
</header>

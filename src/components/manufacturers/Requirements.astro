---
import Collapsible from '@/components/Collapsible.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import type { SectionTone } from '@/components/sections/types';
import { manufacturersPage } from '@/data/manufacturers';
import type { Locale } from '@/i18n/config';
import { t, withCount } from '@/i18n/utils';

interface Props {
  locale: Locale;
  tone?: SectionTone;
}
const { locale, tone = 'white' } = Astro.props;
const data = manufacturersPage[locale].requirements;
const copy = t(locale).manufacturersPage;
const bg = tone === 'surface' ? 'bg-surface' : 'bg-white';

// The first three items are always visible; the rest fold on phones.
const shown = data.common.slice(0, 3);
const rest = data.common.slice(3);
const check = 'M20 6 9 17l-5-5';
---

<section class:list={['py-section-sm md:py-section', bg]} aria-labelledby="requirements-title">
  <div class="container-page">
    <SectionHeading id="requirements-title" title={data.title} lead={data.lead} />
    <div class="mt-8 grid gap-8 md:mt-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h3 class="eyebrow font-sans text-eyebrow">{copy.forAnyProduct}</h3>
        {
          [shown, rest].map((items, i) => {
            const list = (
              <ul class:list={['divide-y divide-line border-t border-line', i === 0 && 'mt-4']}>
                {items.map((item) => (
                  <li class="flex items-start gap-3 py-3 text-base leading-snug text-ink-soft">
                    <svg
                      class="mt-1 size-4 shrink-0 text-primary"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d={check} />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            );
            return i === 0 || items.length === 0 ? (
              list
            ) : (
              <Collapsible
                summary={withCount(copy.listMore, items.length, locale)}
                open
                collapseOnMobile
              >
                {list}
              </Collapsible>
            );
          })
        }
      </div>
      <div class="lg:col-span-7">
        <h3 class="eyebrow font-sans text-eyebrow">{copy.byCategory}</h3>
        <div class="mt-4 flex flex-col gap-2.5">
          {
            data.categories.map((category, i) => (
              <Collapsible
                summary={category.title}
                variant="card"
                open={i === 0}
                collapseOnMobile={i === 0}
              >
                <p class="text-base leading-relaxed text-ink-soft">
                  <strong class="font-bold text-ink">{copy.access}</strong> {category.access}
                </p>
                <p class="mt-3 text-base leading-relaxed text-ink-soft">
                  <strong class="font-bold text-ink">{copy.prepare}</strong> {category.prepare}
                </p>
              </Collapsible>
            ))
          }
        </div>
      </div>
    </div>
    <p class="mt-10 max-w-3xl text-sm leading-relaxed text-muted">{data.footnote}</p>
  </div>
</section>

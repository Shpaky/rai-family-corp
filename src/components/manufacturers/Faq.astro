---
/* Questions without an answer (a: null) are skipped here and in the FAQPage JSON-LD. */
import Collapsible from '@/components/Collapsible.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import type { SectionTone } from '@/components/sections/types';
import { answeredFaq, manufacturersPage } from '@/data/manufacturers';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  tone?: SectionTone;
}
const { locale, tone = 'white' } = Astro.props;
const data = manufacturersPage[locale].faq;
const items = answeredFaq(locale);
const bg = tone === 'surface' ? 'bg-surface' : 'bg-white';
---

<section class:list={['py-section-sm md:py-section', bg]} aria-labelledby="faq-title">
  <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <SectionHeading id="faq-title" title={data.title} lead={data.lead} />
    </div>
    <div class="divide-y divide-line border-y border-line lg:col-span-7">
      {
        items.map((item, i) => (
          <Collapsible summary={item.q} variant="row" open={i === 0} collapseOnMobile={i === 0}>
            <p class="text-base leading-relaxed text-ink-soft">{item.a}</p>
          </Collapsible>
        ))
      }
    </div>
  </div>
</section>

---
/* Pavilion and operator status: the footer StatusLockup, no new version of it. */
import Button from '@/components/Button.astro';
import StatusLockup from '@/components/StatusLockup.astro';
import type { SectionTone } from '@/components/sections/types';
import { manufacturersPage } from '@/data/manufacturers';
import type { Locale } from '@/i18n/config';
import { href, t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  tone?: SectionTone;
}
const { locale, tone = 'white' } = Astro.props;
const data = manufacturersPage[locale].status;
const copy = t(locale);
const bg = tone === 'surface' ? 'bg-surface' : 'bg-white';
const programmeNote = copy.aboutPage.status.programmeNote;
---

<section class:list={['py-section-sm md:py-section', bg]} aria-labelledby="status-title">
  <div class="container-page">
    <h2 id="status-title" class="max-w-3xl text-h2 font-bold text-balance text-ink md:text-h1">
      {data.title}
    </h2>
    <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <StatusLockup locale={locale} variant="footer" />
        <p class="mt-6 text-base leading-relaxed text-ink-soft">{data.text}</p>
        <p class="mt-4 text-sm leading-relaxed text-muted">{copy.footer.madeInRussia}</p>
      </div>
      <div class="lg:col-span-5">
        {
          data.benefits.length > 0 && (
            <>
              <h3 class="text-h3 font-bold text-ink">{data.benefitsTitle}</h3>
              <ul class="mt-4 mb-8 list-disc space-y-2 pl-5 text-base leading-relaxed text-ink-soft">
                {data.benefits.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </>
          )
        }
        <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
          <Button href={`${href(locale)}${data.pavilionHref}`} variant="secondary">
            {copy.hero.pavilionLink}
          </Button>
          <a
            href={data.recHref}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:text-primary-hover"
          >
            {copy.manufacturersPage.recLink}
            {programmeNote && <span class="font-semibold text-muted">({programmeNote})</span>}
            <span class="sr-only">, {copy.external.newTab}</span>
            <svg
              class="size-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M8 7h9v9"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

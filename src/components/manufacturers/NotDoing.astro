---
/* Rendered by the page only when notDoing.items is not empty. */
import SectionHeading from '@/components/SectionHeading.astro';
import type { SectionTone } from '@/components/sections/types';
import { manufacturersPage } from '@/data/manufacturers';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  tone?: SectionTone;
}
const { locale, tone = 'white' } = Astro.props;
const data = manufacturersPage[locale].notDoing;
const bg = tone === 'surface' ? 'bg-surface' : 'bg-white';
---

<section class:list={['py-section-sm md:py-section', bg]} aria-labelledby="not-doing-title">
  <div class="container-page">
    <SectionHeading id="not-doing-title" title={data.title} />
    <ul class="mt-10 grid gap-x-10 gap-y-4 md:grid-cols-2">
      {
        data.items.map((item) => (
          <li class="flex items-start gap-3 text-base leading-relaxed text-ink-soft">
            <svg
              class="mt-1 size-4 shrink-0 text-gold-deep"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

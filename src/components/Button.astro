---
import { buttonStyles, type ButtonStyleProps } from './buttonStyles';
interface Props extends ButtonStyleProps {
  href: string;
  class?: string;
  external?: boolean;
}
const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  external = false,
} = Astro.props;
---

<a
  href={href}
  class:list={[buttonStyles({ variant, size }), className]}
  rel={external ? 'noopener' : undefined}
  target={external ? '_blank' : undefined}
>
  <slot />
</a>

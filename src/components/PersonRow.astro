---
/*
  One leadership row: 160 px portrait, name, role. No links, no heading:
  the section heading is enough. The photo is cropped by CSS only.
*/
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '@/i18n/config';

interface Props {
  entry: CollectionEntry<'people'>;
  locale: Locale;
}
const { entry, locale } = Astro.props;
const text = entry.data.i18n[locale];
---

<div class="flex items-center gap-5">
  <Picture
    src={entry.data.photo}
    alt={text.name}
    widths={[160, 320]}
    sizes="160px"
    formats={['avif', 'webp']}
    loading="lazy"
    class="size-40 shrink-0 rounded-card object-cover object-top"
  />
  <div>
    <p class="text-base leading-snug font-bold text-ink">{text.name}</p>
    <p class="mt-1 text-sm text-muted">{text.role}</p>
  </div>
</div>

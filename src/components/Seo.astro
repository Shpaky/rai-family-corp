---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { LOCALES, OG_LOCALES, type Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Site path without locale prefix, e.g. "" or "directions/vodka/". */
  path?: string;
  ogType?: 'website' | 'article';
}

const { locale, title, description, path = '', ogType = 'website' } = Astro.props;
const canonical = getAbsoluteLocaleUrl(locale, path);
const alternates = LOCALES.map((l) => ({ hreflang: l, href: getAbsoluteLocaleUrl(l, path) }));
const ogImage = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/og.png`, Astro.site);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Rai Family Corp LLP',
  url: getAbsoluteLocaleUrl('en', ''),
  foundingDate: '2024-09',
  address: {
    '@type': 'PostalAddress',
    streetAddress:
      'Office No. 1307 and 1308, NMS Titanium, 13th Floor, Plot No. 74, Sector-15, CBD Belapur',
    addressLocality: 'Navi Mumbai',
    addressRegion: 'Maharashtra',
    postalCode: '400614',
    addressCountry: 'IN',
  },
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', path)} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Rai Family Corp" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={OG_LOCALES[locale]} />
{
  LOCALES.filter((l) => l !== locale).map((l) => (
    <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
  ))
}
<meta name="twitter:card" content="summary_large_image" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />

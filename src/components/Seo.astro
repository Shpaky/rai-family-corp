---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { company, postalAddress } from '@/data/company';
import { contacts, phonesFor } from '@/data/contacts';
import { LOCALES, OG_LOCALES, type Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Site path without locale prefix, e.g. "" or "directions/vodka/". */
  path?: string;
  ogType?: 'website' | 'article';
  /** Extra JSON-LD object for the page (ItemList, Product…). */
  jsonLd?: object;
}

const { locale, title, description, path = '', ogType = 'website', jsonLd } = Astro.props;
const canonical = getAbsoluteLocaleUrl(locale, path);
const alternates = LOCALES.map((l) => ({ hreflang: l, href: getAbsoluteLocaleUrl(l, path) }));
const ogImage = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/og.png`, Astro.site);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Rai Family Corp',
  legalName: company.legalName,
  description: t(locale).meta.description,
  url: getAbsoluteLocaleUrl('en', ''),
  ...(contacts.sameAs.length > 0 ? { sameAs: contacts.sameAs } : {}),
  foundingDate: company.registeredOn,
  ...(contacts.email ? { email: contacts.email } : {}),
  ...(phonesFor(locale).length > 0
    ? { telephone: phonesFor(locale).map((p) => p.replace(/[^\d+]/g, '')) }
    : {}),
  address: postalAddress(),
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', path)} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Rai Family Corp" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={OG_LOCALES[locale]} />
{
  LOCALES.filter((l) => l !== locale).map((l) => (
    <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
  ))
}
<meta name="twitter:card" content="summary_large_image" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

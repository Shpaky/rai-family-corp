---
import StatusLockup from '@/components/StatusLockup.astro';
// Bootstrap Icons, MIT. License is preserved alongside these SVG assets.
import LinkedInIcon from '@/assets/icons/linkedin.svg';
import FacebookIcon from '@/assets/icons/facebook.svg';
import { footerSocialProfiles } from '@/data/contacts';
import { LOCALES, LOCALE_LABELS, type Locale } from '@/i18n/config';
import { href, navItems, t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  path?: string;
}
const { locale, path = '' } = Astro.props;
const copy = t(locale);
const year = new Date().getFullYear();
const links = navItems(locale);
const current = (l: (typeof links)[number]) => Boolean(l.page && path.startsWith(l.page));
const socialIcons = { linkedin: LinkedInIcon, facebook: FacebookIcon };
---

<footer class="border-t border-line bg-white">
  <div class="container-page grid gap-10 py-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <StatusLockup locale={locale} variant="footer" homeLink />
      <p class="mt-4 max-w-sm text-xs leading-relaxed text-muted">{copy.footer.operator}</p>
      <nav aria-label={copy.footer.socialMedia} class="mt-4">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {
            footerSocialProfiles.map((profile) => {
              const Icon = socialIcons[profile.id];
              return (
                <li>
                  <a
                    href={profile.url}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 whitespace-nowrap py-1 text-sm font-semibold text-ink-soft hover:text-primary"
                  >
                    <Icon class="size-4 shrink-0" aria-hidden="true" focusable="false" />
                    <span>
                      {copy.footer.socialLinks[profile.id]}
                      <span class="sr-only">, {copy.external.newTab}</span>
                    </span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>
    <nav aria-label={copy.nav.footerMenu} class="md:col-span-4">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={current(l) ? 'page' : undefined}
                class:list={[
                  'text-sm font-semibold hover:text-primary',
                  current(l) ? 'text-primary' : 'text-ink-soft',
                ]}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label={copy.nav.footerLanguage} class="md:col-span-3">
      <ul class="flex flex-wrap gap-x-4 gap-y-2 md:flex-col">
        {
          LOCALES.map((l) => (
            <li>
              <a
                href={href(l, path)}
                hreflang={l}
                lang={l}
                aria-current={l === locale ? 'page' : undefined}
                class:list={[
                  'text-sm font-semibold hover:text-primary',
                  l === locale ? 'text-primary' : 'text-ink-soft',
                ]}
              >
                {LOCALE_LABELS[l]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <div
      class="container-page flex flex-col gap-2 py-5 text-xs text-muted md:flex-row md:justify-between"
    >
      <p>© {year} {copy.footer.legal}. {copy.footer.rights}</p>
      <p>{copy.footer.madeInRussia}</p>
    </div>
  </div>
</footer>

---
interface Props {
  /** Optional: page sections below a page header go without one. */
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  id?: string;
  as?: 'h1' | 'h2';
}
const { eyebrow, title, lead, align = 'left', id, as: Tag = 'h2' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow text-eyebrow">{eyebrow}</p>}
  <Tag id={id} class:list={['text-h2 font-bold text-ink md:text-h1', eyebrow && 'mt-3']}
    >{title}</Tag
  >
  {lead && <p class="mt-4 text-lead text-ink-soft">{lead}</p>}
</div>

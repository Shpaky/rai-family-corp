---
import {
  contacts,
  phonesFor,
  telUri,
  telegramLabel,
  telegramUrl,
  whatsappUrl,
  whatsappsFor,
} from '@/data/contacts';
import type { SectionTone } from '@/components/sections/types';
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  /** Compact variant for direction pages. */
  compact?: boolean;
  /** Accepted for uniformity with other home sections; Contacts is always dark. */
  tone?: SectionTone;
  /** Anchor of the section; null on pages other than home, where the menu keeps pointing to /#contacts. */
  id?: string | null;
}
const { locale, compact = false, id = 'contacts' } = Astro.props;
const copy = t(locale);
const phones = phonesFor(locale);
const whatsapps = whatsappsFor(locale);

const rows = [
  {
    label: copy.contacts.email,
    value: contacts.email,
    href: contacts.email ? `mailto:${contacts.email}` : null,
  },
  {
    label: copy.contacts.telegram,
    value: contacts.telegram ? telegramLabel(contacts.telegram) : null,
    href: contacts.telegram ? telegramUrl(contacts.telegram) : null,
  },
];
---

<section
  id={id ?? undefined}
  class:list={[
    'scroll-mt-20 bg-dark text-dark-text',
    compact ? 'py-section-sm' : 'py-section-sm md:py-section',
  ]}
  aria-labelledby="contacts-title"
>
  <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <p class="eyebrow text-gold-text">{copy.contacts.eyebrow}</p>
      <h2 id="contacts-title" class="mt-3 text-h2 font-bold text-balance md:text-h1">
        {copy.contacts.title}
      </h2>
      <p class="mt-4 text-lead text-dark-text/80">{copy.contacts.lead}</p>
    </div>
    <div class="lg:col-span-7">
      <dl class="grid gap-px overflow-hidden rounded-card bg-white/15 sm:grid-cols-2">
        <div class="bg-dark p-6">
          <dt class="eyebrow text-gold-text">{copy.contacts.phone}</dt>
          <dd class="mt-2 text-lg font-bold">
            {
              phones.length > 0 ? (
                <ul class="space-y-1">
                  {phones.map((phone) => (
                    <li>
                      <a href={telUri(phone)} class="underline-offset-4 hover:underline">
                        {phone}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <span class="font-semibold text-gold-text">{copy.contacts.placeholder}</span>
              )
            }
          </dd>
        </div>
        <div class="bg-dark p-6">
          <dt class="eyebrow text-gold-text">{copy.contacts.whatsapp}</dt>
          <dd class="mt-2 text-lg font-bold">
            {
              whatsapps.length > 0 ? (
                <ul class="space-y-1">
                  {whatsapps.map((phone) => (
                    <li>
                      <a
                        href={whatsappUrl(phone)}
                        rel="noopener"
                        class="underline-offset-4 hover:underline"
                      >
                        {phone}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <span class="font-semibold text-gold-text">{copy.contacts.placeholder}</span>
              )
            }
          </dd>
        </div>
        {
          rows.map((r) => (
            <div class="bg-dark p-6">
              <dt class="eyebrow text-gold-text">{r.label}</dt>
              <dd class="mt-2 text-lg font-bold">
                {r.href && r.value ? (
                  <a
                    href={r.href}
                    class="underline-offset-4 hover:underline"
                    rel={r.href.startsWith('http') ? 'noopener' : undefined}
                  >
                    {r.value}
                  </a>
                ) : (
                  <span class="font-semibold text-gold-text">{copy.contacts.placeholder}</span>
                )}
              </dd>
            </div>
          ))
        }
        <div class="bg-dark p-6 sm:col-span-2">
          <dt class="eyebrow text-gold-text">{copy.contacts.address}</dt>
          <dd class="mt-2 text-base leading-relaxed">
            <address class="not-italic">
              {contacts.address.map((line) => <span class="block">{line}</span>)}
            </address>
            <a
              href={contacts.mapUrl}
              target="_blank"
              rel="noopener"
              class="mt-3 inline-block text-sm font-bold text-gold-text underline-offset-4 hover:underline"
            >
              {copy.pavilion.map}
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

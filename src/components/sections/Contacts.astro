---
import { contacts } from '@/data/contacts';
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  /** Compact variant for direction pages. */
  compact?: boolean;
}
const { locale, compact = false } = Astro.props;
const copy = t(locale);

const rows = [
  {
    label: copy.contacts.email,
    value: contacts.email,
    href: contacts.email ? `mailto:${contacts.email}` : null,
  },
  {
    label: copy.contacts.phone,
    value: contacts.phone,
    href: contacts.phone ? `tel:${contacts.phone.replace(/\s/g, '')}` : null,
  },
  {
    label: copy.contacts.whatsapp,
    value: contacts.whatsapp ? `+${contacts.whatsapp}` : null,
    href: contacts.whatsapp ? `https://wa.me/${contacts.whatsapp}` : null,
  },
  {
    label: copy.contacts.telegram,
    value: contacts.telegram ? `@${contacts.telegram}` : null,
    href: contacts.telegram ? `https://t.me/${contacts.telegram}` : null,
  },
];
---

<section
  id="contacts"
  class:list={[
    'scroll-mt-20 bg-primary text-white',
    compact ? 'py-section-sm' : 'py-section-sm md:py-section',
  ]}
  aria-labelledby="contacts-title"
>
  <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <p class="eyebrow text-brand-sky-light">{copy.contacts.eyebrow}</p>
      <h2 id="contacts-title" class="mt-3 text-h2 font-extrabold text-balance md:text-h1">
        {copy.contacts.title}
      </h2>
      <p class="mt-4 text-lead text-white/80">{copy.contacts.lead}</p>
    </div>
    <div class="lg:col-span-7">
      <dl class="grid gap-px overflow-hidden rounded-card bg-white/15 sm:grid-cols-2">
        {
          rows.map((r) => (
            <div class="bg-primary p-6">
              <dt class="eyebrow text-brand-sky-light">{r.label}</dt>
              <dd class="mt-2 text-lg font-bold">
                {r.href && r.value ? (
                  <a
                    href={r.href}
                    class="underline-offset-4 hover:underline"
                    rel={r.href.startsWith('http') ? 'noopener' : undefined}
                  >
                    {r.value}
                  </a>
                ) : (
                  <span class="font-semibold text-brand-sky-light">
                    {copy.contacts.placeholder}
                  </span>
                )}
              </dd>
            </div>
          ))
        }
        <div class="bg-primary p-6 sm:col-span-2">
          <dt class="eyebrow text-brand-sky-light">{copy.contacts.address}</dt>
          <dd class="mt-2 text-base leading-relaxed">
            <address class="not-italic">
              {contacts.address.map((line) => <span class="block">{line}</span>)}
            </address>
            <a
              href={contacts.mapUrl}
              target="_blank"
              rel="noopener"
              class="mt-3 inline-block text-sm font-bold text-brand-sky-light underline-offset-4 hover:underline"
            >
              {copy.pavilion.map}
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

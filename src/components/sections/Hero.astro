---
import Button from '@/components/Button.astro';
import StatusLockup from '@/components/StatusLockup.astro';
import type { Locale } from '@/i18n/config';
import { href, t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const home = href(locale);
// The B2B / B2C items are the first mention on the page: a visually hidden
// expansion follows the abbreviation for screen readers.
const trust = [
  { text: copy.trust.pavilion },
  { text: copy.trust.since },
  { text: copy.trust.b2b, abbr: 'B2B' as const },
  { text: copy.trust.b2c, abbr: 'B2C' as const },
];
---

<section class="relative overflow-hidden bg-white">
  <div
    class="container-page grid gap-12 py-section-sm lg:grid-cols-12 lg:items-center lg:py-section"
  >
    <div class="lg:col-span-7">
      <p class="eyebrow text-eyebrow">{copy.hero.eyebrow}</p>
      <h1 class="mt-5 text-h1 font-bold text-balance text-ink md:text-display">
        {copy.hero.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lead text-pretty text-ink-soft">{copy.hero.lead}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <Button href={`${home}#contacts`} size="lg">{copy.hero.ctaPrimary}</Button>
        <Button href={`${home}#directions`} size="lg" variant="secondary"
          >{copy.hero.ctaSecondary}</Button
        >
      </div>
    </div>

    <div class="lg:col-span-5">
      <div
        class="relative overflow-hidden rounded-card bg-dark p-8 text-dark-text shadow-card-hover md:p-10"
      >
        <svg
          class="pointer-events-none absolute -top-24 -right-24 size-96 text-white/10"
          viewBox="0 0 64 64"
          fill="none"
          stroke="currentColor"
          aria-hidden="true"
        >
          <circle cx="32" cy="32" r="30" stroke-width="1"></circle>
          <circle cx="32" cy="32" r="22" stroke-width="1"></circle>
          <circle cx="32" cy="32" r="14" stroke-width="1"></circle>
        </svg>
        <StatusLockup locale={locale} variant="card" tone="dark" eager class="relative" />
        <p class="relative mt-8 text-h3 font-bold text-balance">{copy.hero.cardTitle}</p>
        <p class="relative mt-2 text-sm text-dark-text/80">{copy.pavilion.subtitle}</p>
        <a
          href={`${home}#pavilion`}
          class="relative mt-3 inline-flex items-center gap-1.5 text-sm font-bold text-gold-text underline-offset-4 hover:underline"
        >
          {copy.hero.pavilionLink}
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="border-y border-line bg-surface">
    <ul
      class="container-page grid grid-cols-2 gap-x-6 gap-y-3 py-5 text-sm font-semibold text-ink-soft md:grid-cols-4"
    >
      {
        trust.map((item) => (
          <li class="flex items-start gap-2.5">
            <svg
              class="mt-0.5 size-4 shrink-0 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5" />
            </svg>
            {item.abbr ? (
              <span>
                {[
                  <abbr
                    class="no-underline"
                    title={copy.segmentsExpanded[item.abbr]}
                    set:text={item.abbr}
                  />,
                  <span class="sr-only" set:text={` (${copy.segmentsExpanded[item.abbr]})`} />,
                  item.text.slice(item.abbr.length),
                ]}
              </span>
            ) : (
              item.text
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

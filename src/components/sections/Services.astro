---
/*
  Home teaser of the services: the eight groups of src/data/services.ts as
  compact cards (number, title, one-line summary) and a button to
  /manufacturers/, where the full list is published. No lists here.
*/
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import type { SectionTone } from '@/components/sections/types';
import { services } from '@/data/services';
import type { Locale } from '@/i18n/config';
import { href, t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  /** Background, decided by src/data/site.ts. */
  tone?: SectionTone;
}
const { locale, tone = 'white' } = Astro.props;
const bg = tone === 'surface' ? 'bg-surface' : 'bg-white';
const copy = t(locale);
const groups = services[locale].groups;
---

<section
  id="services"
  class:list={['scroll-mt-20 py-section-sm md:py-section', bg]}
  aria-labelledby="services-title"
>
  <div class="container-page">
    <SectionHeading
      id="services-title"
      eyebrow={copy.services.eyebrow}
      title={copy.services.title}
      lead={copy.services.lead}
    />
    <ol class="mt-10 grid gap-4 md:mt-12 md:grid-cols-2 md:gap-5 xl:grid-cols-4 xl:gap-4">
      {
        groups.map((group) => (
          <li class="rounded-card border border-line bg-white p-6 shadow-card">
            <div class="flex items-baseline gap-4">
              <span class="text-h2 font-bold text-gold-deep tabular-nums xl:text-h3">
                {group.id}
              </span>
              <h3 class="text-h3 font-bold text-ink xl:text-lg xl:leading-snug">{group.title}</h3>
            </div>
            <p class="mt-3 text-base leading-relaxed text-ink-soft">{group.brief}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-10">
      <Button href={href(locale, 'manufacturers/')} variant="secondary">
        {copy.services.more}
      </Button>
    </p>
  </div>
</section>

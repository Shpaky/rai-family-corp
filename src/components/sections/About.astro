---
import { getCollection } from 'astro:content';
import PersonRow from '@/components/PersonRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import type { SectionTone } from '@/components/sections/types';
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  /** Background, decided by src/data/site.ts. */
  tone?: SectionTone;
}
const { locale, tone = 'surface' } = Astro.props;
const bg = tone === 'surface' ? 'bg-surface' : 'bg-white';
const copy = t(locale);
const leadership = (await getCollection('people', (e) => e.data.group === 'leadership')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
  id="about"
  class:list={['scroll-mt-20 py-section-sm md:py-section', bg]}
  aria-labelledby="about-title"
>
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <SectionHeading id="about-title" eyebrow={copy.about.eyebrow} title={copy.about.title} />
      <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink-soft">
        {copy.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
    {
      leadership.length > 0 && (
        <div class="self-start lg:col-span-5">
          <p class="eyebrow text-muted">{copy.about.leadership}</p>
          <ul class="mt-4 grid gap-5">
            {leadership.map((entry) => (
              <li>
                <PersonRow entry={entry} locale={locale} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

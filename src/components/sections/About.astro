---
import SectionHeading from '@/components/SectionHeading.astro';
import type { SectionTone } from '@/components/sections/types';
import type { Locale } from '@/i18n/config';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  /** Background, decided by src/data/site.ts. */
  tone?: SectionTone;
}
const { locale, tone = 'surface' } = Astro.props;
const bg = tone === 'surface' ? 'bg-surface' : 'bg-white';
const copy = t(locale);
---

<section
  id="about"
  class:list={['scroll-mt-20 py-section-sm md:py-section', bg]}
  aria-labelledby="about-title"
>
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <SectionHeading id="about-title" eyebrow={copy.about.eyebrow} title={copy.about.title} />
      <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink-soft">
        {copy.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <div class="lg:col-span-5">
      <dl
        class="grid gap-px overflow-hidden rounded-card border border-line bg-line shadow-card sm:grid-cols-2 lg:grid-cols-1"
      >
        {
          copy.about.facts.map((f, i) => (
            <div class:list={['p-6', i === 0 ? 'bg-warm' : 'bg-white']}>
              <dt class="eyebrow text-muted">{f.label}</dt>
              <dd class="mt-2 text-lg font-extrabold text-ink">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

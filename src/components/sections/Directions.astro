---
import Button from '@/components/Button.astro';
import CategoryTiles from '@/components/CategoryTiles.astro';
import DirectionCard from '@/components/DirectionCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SHOW_CATEGORY_TILES } from '@/data/site';
import type { SectionTone } from '@/components/sections/types';
import type { Locale } from '@/i18n/config';
import { href, t, withCount } from '@/i18n/utils';
import {
  categoryOf,
  getCategoriesWithDirections,
  getDirections,
  pickCarousel,
} from '@/lib/directions';

interface Props {
  locale: Locale;
  /** Background, decided by src/data/site.ts. */
  tone?: SectionTone;
}
const { locale, tone = 'surface' } = Astro.props;
const bg = tone === 'surface' ? 'bg-surface' : 'bg-white';
const copy = t(locale);
const all = await getDirections();
const groups = await getCategoriesWithDirections(all);
const categories = groups.map((g) => g.category);
const carousel = pickCarousel(all);
const arrow =
  'inline-flex size-11 items-center justify-center rounded-pill border border-line bg-white text-primary transition-colors hover:border-primary disabled:cursor-not-allowed disabled:opacity-40';
---

<section
  id="directions"
  class:list={['scroll-mt-20 py-section-sm md:py-section', bg]}
  aria-labelledby="directions-title"
  data-carousel
>
  <div class="container-page">
    <div class="flex items-end justify-between gap-6">
      <SectionHeading
        id="directions-title"
        eyebrow={copy.directions.eyebrow}
        title={copy.directions.title}
        lead={copy.directions.lead}
      />
      <div class="hidden shrink-0 items-center gap-2 md:flex">
        <button
          type="button"
          class={arrow}
          aria-label={copy.directions.carousel.prev}
          data-carousel-prev
          hidden
        >
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg
          >
        </button>
        <button
          type="button"
          class={arrow}
          aria-label={copy.directions.carousel.next}
          data-carousel-next
          hidden
        >
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg
          >
        </button>
      </div>
    </div>

    {SHOW_CATEGORY_TILES && <CategoryTiles locale={locale} groups={groups} />}

    <div
      class="-mx-5 mt-12 snap-x snap-mandatory overflow-x-auto scroll-smooth px-5 pb-2 scroll-px-5 md:-mx-8 md:px-8 md:scroll-px-8"
      tabindex="0"
      role="region"
      aria-label={copy.directions.carousel.label}
      data-carousel-track
    >
      <ul class="flex gap-5">
        {
          carousel.map((entry, i) => (
            <li class="shrink-0 basis-80 snap-start md:basis-88">
              <DirectionCard
                entry={entry}
                category={categoryOf(entry, categories)}
                locale={locale}
                eager={i < 3}
              />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10">
      <Button href={href(locale, 'directions/')} variant="secondary">
        {withCount(copy.directions.allCount, all.length, locale)}
      </Button>
    </div>
  </div>
</section>

<script>
  // Carousel arrows: progressive enhancement over a scroll-snap strip.
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !prev || !next) continue;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const step = () => {
      const first = track.querySelector<HTMLElement>('li');
      const list = track.querySelector<HTMLElement>('ul');
      const gap = list ? parseFloat(getComputedStyle(list).columnGap) || 0 : 0;
      return first ? first.offsetWidth + gap : track.clientWidth;
    };
    const update = () => {
      const overflow = track.scrollWidth > track.clientWidth + 1;
      prev.hidden = next.hidden = !overflow;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };
    const scroll = (dir: number) =>
      track.scrollBy({ left: dir * step(), behavior: reduce ? 'instant' : 'smooth' });
    prev.addEventListener('click', () => scroll(-1));
    next.addEventListener('click', () => scroll(1));
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  }
</script>

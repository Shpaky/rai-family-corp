---
import SectionHeading from '@/components/SectionHeading.astro';
import type { Locale } from '@/i18n/config';
import type { AudienceKey } from '@/i18n/ui';
import { href, t } from '@/i18n/utils';
import { company } from '@/data/company';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = t(locale);
const home = href(locale);

const targets: Record<AudienceKey, { href: string; external?: boolean }> = {
  manufacturers: { href: `${home}#services` },
  distributors: { href: `${home}#directions` },
  institutions: { href: `${home}#pavilion` },
  consumers: { href: company.store.url, external: true },
};
const order: AudienceKey[] = ['manufacturers', 'distributors', 'institutions', 'consumers'];

// One stroke icon per audience, 24px grid.
const icons: Record<AudienceKey, string> = {
  manufacturers: 'M3 21V9l6 3V9l6 3V7l6-3v17H3z',
  distributors:
    'M3 7h13v10H3zM16 10h3l2 3v4h-5zM7 20a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM17 20a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z',
  institutions: 'M3 10l9-6 9 6M5 10v9M9 10v9M15 10v9M19 10v9M3 19h18',
  consumers:
    'M6 7h14l-1.5 8h-11zM6 7 5 4H3M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM16 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z',
};
---

<section class="bg-white py-section-sm md:py-section" aria-labelledby="audiences-title">
  <div class="container-page">
    <SectionHeading
      id="audiences-title"
      eyebrow={copy.audiences.eyebrow}
      title={copy.audiences.title}
      lead={copy.audiences.lead}
    />
    <ul class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {
        order.map((key) => {
          const item = copy.audiences.items[key];
          const segment = copy.audiences.segments[key];
          const b2c = segment === 'B2C';
          return (
            <li
              class:list={[
                'group flex flex-col rounded-card border border-line p-7 shadow-card transition-shadow hover:shadow-card-hover',
                'bg-white',
              ]}
            >
              <div class="flex items-start justify-between gap-3">
                <span
                  class:list={[
                    'flex size-12 items-center justify-center rounded-2xl',
                    b2c ? 'bg-warm text-brand-red-dark' : 'bg-primary-soft text-primary',
                  ]}
                >
                  <svg
                    class="size-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d={icons[key]} />
                  </svg>
                </span>
                <abbr
                  title={copy.segmentsExpanded[segment]}
                  class:list={[
                    'rounded-pill px-2.5 py-1 text-xs font-bold tracking-wide no-underline',
                    b2c ? 'bg-warm text-brand-red-dark' : 'bg-primary-soft text-primary',
                  ]}
                  set:text={segment}
                />
              </div>
              <h3 class="mt-6 text-h3 font-extrabold text-ink">{item.title}</h3>
              <p class="mt-3 flex-1 text-base leading-relaxed text-ink-soft">{item.text}</p>
              <a
                href={targets[key].href}
                target={targets[key].external ? '_blank' : undefined}
                rel={targets[key].external ? 'noopener' : undefined}
                class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-primary hover:text-primary-hover"
              >
                {item.cta}
                <svg
                  class="size-4 motion-safe:transition-transform motion-safe:group-hover:translate-x-0.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

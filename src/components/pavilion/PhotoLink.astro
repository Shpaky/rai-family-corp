---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  id: string;
  src: ImageMetadata;
  alt: string;
  caption: string;
  enlarge: string;
  date?: string;
  dateLabel?: string;
  detailCaption?: string;
  interior?: boolean;
  sizes?: string;
}
const {
  id,
  src,
  alt,
  caption,
  enlarge,
  date,
  dateLabel,
  detailCaption,
  interior = false,
  sizes,
} = Astro.props;
const full = await getImage({ src, width: Math.min(src.width, 1920), format: 'webp' });
---

<a
  data-photo={id}
  data-title={caption}
  data-caption={detailCaption}
  href={full.src}
  aria-label={`${enlarge}: ${caption}${dateLabel ? ', ' + dateLabel : ''}`}
  class="block overflow-hidden rounded-card border border-line bg-white shadow-card hover:shadow-card-hover"
>
  <figure>
    <Picture
      src={src}
      formats={['avif', 'webp']}
      widths={interior ? [480, 768, 1024] : [320, 480, 768, 1024]}
      sizes={sizes ??
        (interior ? '(min-width: 768px) 33vw, 80vw' : '(min-width: 768px) 33vw, 100vw')}
      alt={alt}
      loading="lazy"
      class="aspect-4/3 w-full bg-surface object-contain"
    />
    <figcaption class="flex justify-between gap-3 p-3 text-xs text-muted">
      <span
        >{caption}{
          date && (
            <time datetime={date} class="block">
              {dateLabel}
            </time>
          )
        }</span
      >
      <span aria-hidden="true" class="text-primary">↗</span>
    </figcaption>
  </figure>
</a>
